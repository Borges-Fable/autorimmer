#!/usr/bin/env python3
"""cockpit — watch an agent play RimWorld, or replay a run it already played.

    cockpit m1-20260901                 replay a finished run
    cockpit m1-20260901 --follow        tail one that is still growing
    cockpit --live                      whatever the bench is writing right now
    cockpit m1-20260901 --at 2400       open at a step
    cockpit m1-20260901 --probe         resolution and counts, no terminal
    cockpit m1-20260901 --screenshot out.svg [--size 130x40] [--page 1]

`tab` switches between the flight deck (the colony) and the rig (the agent's
own instruments: the verb surface it could reach, the shelf it was reading, and
the checklist it recorded).

THIS TOOL SENDS NOTHING. No verb, ever, not even an observer, and no socket. It
reads `transcripts/<run>/NNN-<op>/{cmd,result}.json` and the journal ndjson —
files the mod and `rwa` already wrote. That is not a style choice: `journal`
moves `Journal.ReadWatermark` (JournalVerbs.cs:152), which is what `advance`
compares against before it will run again, so a cockpit that called it would
discharge the driving agent's obligation and let its next advance run past
unread events. `digest` would write `commands/<id>.json` and claim a step
directory in the driver's own run. `verify-readonly.py` is the proof.

Live mode is replay mode tailing a directory that is still growing: one parser,
one renderer, one code path.
"""

import os
import sys

# No __pycache__: the contract is that this writes nothing, and the import
# machinery is the one part of a stdlib program that writes unasked.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import transcript as T                                        # noqa: E402

VERSION = "0.1.0"
VALUED = {"--transcripts", "--journal", "--root", "--at", "--screenshot",
          "--size", "--page"}


def die(msg):
    print(f"cockpit: {msg}", file=sys.stderr)
    sys.exit(2)


def parse(argv):
    o = {"specs": [], "follow": False, "live": False, "probe": False, "at": None,
         "screenshot": None, "size": None, "transcripts": None, "journal": None,
         "root": None, "page": "0"}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--help", "-h"):
            print(__doc__.strip())
            sys.exit(0)
        elif a == "--version":
            print(f"cockpit {VERSION}")
            sys.exit(0)
        elif a in ("--follow", "-f"):
            o["follow"] = True
        elif a == "--live":
            o["live"] = o["follow"] = True
        elif a == "--probe":
            o["probe"] = True
        elif a in VALUED:
            if i + 1 >= len(argv):
                die(f"{a} needs a value")
            i += 1
            o[a.lstrip("-")] = argv[i]
        elif a.startswith("-"):
            die(f"unknown option {a}")
        else:
            o["specs"].append(a)
        i += 1
    if o["at"] is not None:
        try:
            o["at"] = int(o["at"]) - 1
        except ValueError:
            die("--at wants a step number")
    if o["size"]:
        try:
            o["size"] = tuple(int(x) for x in str(o["size"]).lower().split("x"))
        except ValueError:
            die("--size wants WIDTHxHEIGHT, e.g. 130x40")
    return o


def resolve(o):
    troot = T.transcripts_root(o["transcripts"])
    specs = list(o["specs"])
    if not specs:
        if not o["live"]:
            die("name a run, or pass --live\n\n" + __doc__.strip())
        # `--live` must name a run without asking the bench which one it is on:
        # status.json's sid is the GAME session, which is the transcript's
        # default name but not its name under RWA_RUN. Newest mtime is the
        # honest answer — the directory a step was last claimed in.
        dirs = [p for p in troot.iterdir() if p.is_dir()] if troot.is_dir() else []
        if not dirs:
            die(f"no run directories under {troot}")
        specs = [str(max(dirs, key=lambda p: p.stat().st_mtime))]
    segments, missing = T.resolve_chain(specs, troot)
    if missing:
        die("no transcript directory matched: " + ", ".join(missing))
    run = T.Run(segments)
    if not run.steps:
        die(f"{segments[0].name} has no step directories")
    base = T.seg_key(segments[0])[0]
    jpath = T.find_journal(run.sid, [o["journal"],
                                     T.repo_root() / "RUNS" / base,
                                     troot.parent / "RUNS" / base,
                                     T.resolve_root(o["root"])])
    return run, (T.Journal(jpath) if jpath else None), jpath, troot, specs, base


def probe(run, journal, jpath, troot, specs):
    """Everything the TUI resolved, as text — what `verify-readonly.py` drives,
    and what to run first when a chain looks short."""
    inflight = [s.key for s in run.steps if s.in_flight]
    bad = sum(1 for s in run.steps if s.ok is False)
    maps = [s.key for s in run.steps if s.op == "map-view"]
    print(f"transcripts   {troot}")
    print(f"specs         {' '.join(specs)}")
    print(f"chain         {len(run.segments)} segment(s): "
          + " -> ".join(s.name for s in run.segments))
    print(f"steps         {len(run.steps):,}")
    print(f"sid           {run.sid}")
    print(f"journal       {jpath or '(not found)'}"
          + (f"   {len(journal.entries):,} entries" if journal else ""))
    if run.day_starts:
        print(f"days          {run.day_starts[0][0]}..{run.day_starts[-1][0]}")
    print(f"no result     {len(inflight)}"
          + ("   " + ", ".join(inflight) if inflight else ""))
    print(f"ok / error    {len(run.steps) - bad:,} / {bad:,}")
    print(f"map-views     {len(maps)}")


def main(argv):
    o = parse(argv)
    run, journal, jpath, troot, specs, base = resolve(o)
    if o["probe"]:
        probe(run, journal, jpath, troot, specs)
        return 0

    import ui
    repo = T.repo_root()
    app = ui.Cockpit(run, journal, follow=o["follow"], at=o["at"], specs=specs,
                     root=troot, repo=repo, run_dir=repo / "RUNS" / base,
                     page=1 if str(o["page"]) == "1" else 0,
                     source=f"{len(run.segments)} seg · "
                            f"{jpath.name if jpath else 'no journal'}")
    if o["screenshot"]:
        import asyncio

        async def shot():
            # Let the first layout land: panes report width 0 until it has, and
            # the verb grid and the map caption both size themselves off it.
            async with app.run_test(size=o["size"] or (130, 40)) as pilot:
                await pilot.pause(0.3)
                app.save_screenshot(o["screenshot"])
        asyncio.run(shot())
        print(o["screenshot"])
        return 0
    app.run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
