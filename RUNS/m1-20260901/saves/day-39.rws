		<questManager>
			<quests>
				<li>
					<name>Mechanoid Signal</name>
					<appearanceTick>361000</appearanceTick>
					<acceptedBy>null</acceptedBy>
					<challengeRating>-1</challengeRating>
					<description>You've detected a signal from a mechanoid ship in orbit. The ship has malfunctioned and is slowly losing altitude.

By falsely responding to the signal you can make the ship crashland nearby, letting you salvage valuable grav tech.</description>
					<root>MechanoidSignal</root>
					<signalsReceivedDebug IsNull="True" />
					<parts>
						<li Class="QuestPart_SpawnThing">
							<inSignal>Quest0.OuterNodeCompleted</inSignal>
							<thing Class="Skyfaller">
								<def>ShipChunkIncoming_SmallExplosion</def>
								<id>ShipChunkIncoming_SmallExplosion52064</id>
								<questTags IsNull="True" />
								<despawnedTick>-1</despawnedTick>
								<innerContainer Class="Verse.ThingOwner`1[Verse.Thing]">
									<innerList>
