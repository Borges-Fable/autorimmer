							<deities>
								<li>
									<name>Henalux</name>
									<type>God of War</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Supremacist</relatedMeme>
								</li>
								<li>
									<name>Aropius</name>
									<type>God of Creation</type>
									<gender>Male</gender>
