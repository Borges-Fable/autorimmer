						<name>Nightmare Deep</name>
						<adjective>archist</adjective>
						<memberName>Archist</memberName>
						<leaderTitleMale>Top Boss</leaderTitleMale>
						<leaderTitleFemale>Top Boss</leaderTitleFemale>
						<description>You see space as a grid, pure and mathematical. We know it is only the glassy surface of a black ocean of nightmares buried under every place and every moment. We know the mind who reigns from the deep. Its thoughts reach up from the boiling darkness and reward those who serve its will.</description>
						<descriptionTemplate>Our universe is a dream in the mind of a timeless universal consciousness. Only archotechs can communicate directly with the universal consciousness. Archotechs are evil and the most important task for humanity is to understand them so we can escape their influence. In the end, the archotechs will finish their moral debate about the fate of humanity. Those who follow their signs will be admitted to a higher plane of existence, and those that do not will end.</descriptionTemplate>
						<culture>Kriminul</culture>
						<iconDef>StarsD</iconDef>
						<colorDef>LightBlue</colorDef>
						<primaryFactionColor>RGBA(0.110, 0.478, 0.400, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Archist</li>
							<li>Inhuman</li>
							<li>Ritualist</li>
						</memes>
						<precepts>
							<li>
								<name>inhumanizing</name>
								<def>Inhumanizing_Required</def>
								<ID>478</ID>
								<randomSeed>611887711</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>void study</name>
								<def>VoidStudy_VeryEfficient</def>
								<ID>479</ID>
								<randomSeed>774323751</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>research</name>
								<def>Research_Slow</def>
								<ID>480</ID>
								<randomSeed>-402216761</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Mourning of Rage</name>
								<def>Funeral</def>
								<ID>481</ID>
								<randomSeed>55201339</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>You can hold a {IDEOLIGION_adjective} funeral for {PAWN_nameDef}.</ritualExpectedDesc>
								<ritualExpectedDescNoAdjective>You can hold a funeral for {PAWN_nameDef}.</ritualExpectedDescNoAdjective>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_481</parent>
								</obligationTargetFilter>
