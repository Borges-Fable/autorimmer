								<attachableOutcomeEffect>RechargePsyfocus</attachableOutcomeEffect>
								<outcomeEffect Class="RitualOutcomeEffectWorker_Consumable">
									<def>Sacrifice</def>
									<compDatas>
										<li IsNull="True" />
