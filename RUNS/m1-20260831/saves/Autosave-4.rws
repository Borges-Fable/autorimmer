								<li>
									<name>Durga</name>
									<type>Warrior Goddess</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Supremacist</relatedMeme>
								</li>
								<li>
									<name>Svaha</name>
									<type>God of Ash</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Cannibal</relatedMeme>
								</li>
								<li>
									<name>Bhairava</name>
									<type>God of Annihilation</type>
